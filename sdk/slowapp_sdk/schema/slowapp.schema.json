{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mike-anderson/epaper-dashboard/panes/schema/slowapp.schema.json",
  "title": "Slowapp manifest (contracts 3 to 6)",
  "description": "slowapp.toml at an app repo's root, parsed as TOML. See MANIFEST.md. Structural rules only; `slowapp validate` adds the cross-field rules.",
  "type": "object",
  "required": ["app"],
  "additionalProperties": false,
  "properties": {
    "app": {
      "type": "object",
      "required": ["id", "title", "contract", "image", "memory", "timeout_s", "network"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,23}$"},
        "title": {"type": "string", "minLength": 1, "maxLength": 40},
        "contract": {"enum": [3, 4, 5, 6]},
        "image": {"type": "string", "pattern": "^[a-z0-9.-]+(:[0-9]+)?(/[a-z0-9._-]+)+$"},
        "memory": {"$ref": "#/$defs/size"},
        "tmp": {"$ref": "#/$defs/size"},
        "timeout_s": {"type": "integer", "minimum": 1, "maximum": 3600},
        "network": {"enum": ["none", "egress"]},
        "secrets": {"$ref": "#/$defs/names"},
        "optional_secrets": {"$ref": "#/$defs/names"},
        "data": {
          "type": "object", "additionalProperties": false,
          "properties": {"max_mb": {"type": "integer", "minimum": 0, "maximum": 4096}}
        },
        "cache": {
          "type": "object", "additionalProperties": false,
          "properties": {"tmpfs_mb": {"type": "integer", "minimum": 0, "maximum": 256}}
        },
        "exports": {"$ref": "#/$defs/names"},
        "imports": {
          "type": "array", "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,23}:[a-z][a-z0-9_-]{0,31}$"}
        },
        "prompts": {"type": "boolean"},
        "blurb": {"type": "string", "minLength": 1, "maxLength": 100},
        "about": {"type": "string", "minLength": 1, "maxLength": 800},
        "ink": {"enum": ["black", "white", "yellow", "red"]},
        "license": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9.+() -]{0,63}$"},
        "repo": {"type": "string", "maxLength": 200, "pattern": "^https://[^/\\s][^\\s]*$"}
      }
    },
    "settings": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]{0,31}$"},
      "additionalProperties": {"$ref": "#/$defs/setting"}
    },
    "ui": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "idle_s": {"type": "integer", "minimum": 10, "maximum": 3600},
        "start_timeout_s": {"type": "integer", "minimum": 1, "maximum": 120},
        "entry": {"type": "string", "pattern": "^(/[A-Za-z0-9._-]+)+\\.html$", "maxLength": 128},
        "backend": {"type": "boolean"}
      }
    },
    "docs": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]{0,31}$"},
      "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "properties": {
          "max_kb": {"type": "integer", "minimum": 1, "maximum": 1024},
          "on_change": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,31}$"}},
          "writer": {"enum": ["ui", "job", "both"]}
        }
      }
    },
    "secrets": {
      "description": "Contract 6: the app's secrets, each a value or an OAuth sign-in. A job gets only the ones its [[job]] secrets names.",
      "type": "object",
      "propertyNames": {"pattern": "^[a-z][a-z0-9_-]{0,31}$"},
      "additionalProperties": {"$ref": "#/$defs/secret"}
    },
    "auth": {
      "description": "Contract 6: OAuth providers an oauth secret signs in with. The hub holds the client; the manifest only says where and what to ask for.",
      "type": "object",
      "propertyNames": {"pattern": "^[a-z][a-z0-9_-]{0,31}$"},
      "additionalProperties": {"$ref": "#/$defs/auth"}
    },
    "artifacts": {
      "description": "Contract 6: what sync jobs write to /out/artifacts/<name>/ and render reads at /in/artifacts/<name>/.",
      "type": "object",
      "propertyNames": {"pattern": "^[a-z][a-z0-9_-]{0,31}$"},
      "additionalProperties": {
        "type": "object", "required": ["max_kb"], "additionalProperties": false,
        "properties": {"max_kb": {"type": "integer", "minimum": 1, "maximum": 65536}}
      }
    },
    "events": {
      "type": "object", "additionalProperties": false,
      "properties": {"accept": {"$ref": "#/$defs/names"}}
    },
    "job": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["name"], "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,31}$"},
          "kind": {"enum": ["sync", "render"]},
          "network": {"enum": ["none", "egress"]},
          "secrets": {"$ref": "#/$defs/names"},
          "every": {"type": "string", "pattern": "^[1-9][0-9]*(m|h)$"},
          "min_every": {"type": "string", "pattern": "^[1-9][0-9]*(m|h)$"},
          "jitter_s": {"type": "integer", "minimum": 0, "maximum": 3600},
          "daily": {"type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"},
          "inputs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^(self|[a-z][a-z0-9-]{1,23}):[a-z][a-z0-9_-]{0,31}$"}},
          "expected_s": {"type": "integer", "minimum": 1, "maximum": 3600},
          "args": {
            "type": "object",
            "propertyNames": {"pattern": "^[a-z][a-z0-9_]{0,31}$"},
            "additionalProperties": {"enum": ["string", "number", "integer", "boolean"]}
          }
        }
      }
    },
    "feed": {
      "type": "array",
      "items": {
        "type": "object", "required": ["name", "size"], "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,31}$"},
          "size": {"type": "string", "pattern": "^(slot|[0-9]{1,4}x[0-9]{1,4})$"},
          "inks": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["k4", "g16"]}}
        }
      }
    },
    "example": {
      "type": "array",
      "items": {
        "type": "object", "required": ["name", "fixture", "now", "feeds"], "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,31}$"},
          "caption": {"type": "string"},
          "fixture": {"type": "string", "pattern": "^fixtures/[A-Za-z0-9._/-]+$"},
          "now": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(:[0-9]{2})?([+-][0-9]{2}:[0-9]{2}|Z)$"},
          "job": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,31}$"},
          "tz": {"type": "string"},
          "settings": {"type": "object"},
          "feeds": {
            "type": "object", "minProperties": 1,
            "additionalProperties": {"type": "string", "pattern": "^[0-9]{1,4}x[0-9]{1,4}\\.(k4|g16)$"}
          }
        }
      }
    },
    "ci": {
      "description": "CI-only hints; the hub ignores this table.",
      "type": "object", "additionalProperties": false,
      "properties": {
        "depends": {"type": "array", "items": {"type": "string"}}
      }
    }
  },
  "$defs": {
    "size": {"type": "string", "pattern": "^[1-9][0-9]*[kmg]$"},
    "https": {"type": "string", "maxLength": 512, "pattern": "^https://[^/\\s?#][^\\s#]*$"},
    "secret": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "kind": {"enum": ["value", "oauth"]},
        "label": {"type": "string", "minLength": 1, "maxLength": 60},
        "help": {"type": "string", "maxLength": 400},
        "optional": {"type": "boolean"},
        "auth": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,31}$"},
        "multiple": {"type": "boolean"}
      }
    },
    "auth": {
      "type": "object", "required": ["authorize_url", "token_url"], "additionalProperties": false,
      "properties": {
        "label": {"type": "string", "minLength": 1, "maxLength": 60},
        "authorize_url": {"$ref": "#/$defs/https"},
        "token_url": {"$ref": "#/$defs/https"},
        "revoke_url": {"$ref": "#/$defs/https"},
        "scopes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^\\S{1,200}$"}},
        "pkce": {"type": "boolean"},
        "params": {
          "type": "object",
          "propertyNames": {"pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"},
          "additionalProperties": {"type": "string", "maxLength": 200}
        }
      }
    },
    "names": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,31}$"}},
    "setting": {
      "type": "object", "required": ["type"], "additionalProperties": false,
      "properties": {
        "type": {"enum": ["string", "number", "integer", "boolean", "choice"]},
        "label": {"type": "string"},
        "help": {"type": "string"},
        "optional": {"type": "boolean"},
        "default": {},
        "min": {"type": "number"},
        "max": {"type": "number"},
        "choices": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    }
  }
}
